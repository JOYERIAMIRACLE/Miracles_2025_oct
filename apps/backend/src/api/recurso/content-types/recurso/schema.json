{
  "kind": "collectionType",
  "collectionName": "recursos",
  "info": {
    "singularName": "recurso",
    "pluralName": "recursos",
    "displayName": "Portal - Recurso Descargable"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "nombre":      { "type": "string", "required": true },
    "descripcion": { "type": "text", "maxLength": 300 },
    "archivo":     { "type": "media", "multiple": false, "required": true, "allowedTypes": ["files", "images"] },
    "activo":      { "type": "boolean", "default": true },
    "orden":       { "type": "integer", "default": 0 },
    "seccion":     { "type": "string", "required": true },
    "categoria":   { "type": "string", "maxLength": 80 },
    "grupo":       { "type": "string", "maxLength": 80 },
    "variante":    { "type": "string", "maxLength": 60 },
    "tipo":        { "type": "string", "maxLength": 80 },
    "fecha_lanzamiento": { "type": "date" },
    "rol_autor":   { "type": "string", "maxLength": 40 }
  }
}

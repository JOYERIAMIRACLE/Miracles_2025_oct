{
  "kind": "collectionType",
  "collectionName": "transaccions",
  "info": {
    "singularName": "transaccion",
    "pluralName": "transaccions",
    "displayName": "Transaccion"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "descripcion": {
      "type": "string",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "ingreso",
        "gasto",
        "transferencia"
      ],
      "required": true
    },
    "monto": {
      "type": "decimal",
      "required": true
    },
    "fecha": {
      "type": "datetime",
      "required": true
    },
    "categoria": {
      "type": "string"
    },
    "notas": {
      "type": "text"
    },
    "cuentaOrigen": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cuenta.cuenta"
    },
    "cuentaDestino": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cuenta.cuenta"
    },
    "ambito": {
      "type": "enumeration",
      "enum": ["trabajo", "empresa"],
      "default": "trabajo"
    },
    "comprobante": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "proveedor": {
      "type": "string"
    },
    "factura": {
      "type": "string"
    },
    "metodoPago": {
      "type": "enumeration",
      "enum": ["Efectivo", "Transferencia", "Tarjeta", "Otro"]
    },
    "referencia": {
      "type": "string"
    },
    "clienteDocumentId": {
      "type": "string"
    },
    "centro_costo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::centro-costo.centro-costo",
      "inversedBy": "transacciones"
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente"
    },
    "ventaOrigen": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::venta.venta",
      "inversedBy": "pagos"
    },
    "ventaQueLoGenero": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::venta.venta",
      "mappedBy": "transaccionGenerada"
    }
  }
}

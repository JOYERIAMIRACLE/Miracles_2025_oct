{
  "kind": "collectionType",
  "collectionName": "cotizaciones",
  "info": {
    "singularName": "cotizacion",
    "pluralName": "cotizaciones",
    "displayName": "Cotización"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "numero": {
      "type": "string"
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente",
      "inversedBy": "cotizaciones"
    },
    "items": {
      "type": "json"
    },
    "precioEnvio": {
      "type": "decimal",
      "default": 0
    },
    "total": {
      "type": "decimal",
      "default": 0
    },
    "estado": {
      "type": "enumeration",
      "enum": ["Borrador", "Enviada", "Aceptada", "Rechazada", "Convertida"],
      "default": "Borrador"
    },
    "notas": {
      "type": "text"
    },
    "fecha": {
      "type": "datetime"
    },
    "validoHasta": {
      "type": "date"
    },
    "ventaGenerada": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::venta.venta",
      "inversedBy": "cotizacionOrigen"
    }
  }
}

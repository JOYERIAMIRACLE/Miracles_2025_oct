{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nombreProducto": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombreProducto"
    },
    "sku": {
      "type": "string"
    },
    "descripcion": {
      "type": "text"
    },
    "figura": {
      "type": "string"
    },
    "talla": {
      "type": "string"
    },
    "categoriaJoya": {
      "type": "enumeration",
      "enum": [
        "Anillos",
        "Cadenas",
        "Esclavas",
        "Dijes",
        "Broqueles",
        "Aretes",
        "Pulsos",
        "Rosarios",
        "Argollas"
      ]
    },
    "materialProducto": {
      "type": "enumeration",
      "enum": [
        "Oro 10k",
        "Plata 925"
      ]
    },
    "costoProduccion": {
      "type": "decimal"
    },
    "costo": {
      "type": "decimal"
    },
    "stock": {
      "type": "integer",
      "default": 0
    },
    "material": {
      "type": "enumeration",
      "enum": [
        "producto",
        "servicio"
      ],
      "default": "producto"
    },
    "imagenes": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "activo": {
      "type": "boolean",
      "default": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "puntoVenta": {
      "type": "boolean",
      "default": false
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "products"
    },
    "contenidoo": {
      "type": "richtext"
    },
    "pesoGramos": {
      "type": "decimal"
    },
    "costoManoObra": {
      "type": "decimal"
    },
    "materialInsumo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::material.material"
    },
    "atributos": {
      "type": "component",
      "component": "joyeria.atributos-joya",
      "repeatable": false
    }
  }
}

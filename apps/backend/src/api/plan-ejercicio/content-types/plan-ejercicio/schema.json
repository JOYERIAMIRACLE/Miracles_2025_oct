{
  "kind": "collectionType",
  "collectionName": "plan_ejercicios",
  "info": {
    "singularName": "plan-ejercicio",
    "pluralName": "plan-ejercicios",
    "displayName": "Plan de Ejercicio"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "semanaInicio": { "type": "date", "required": true },

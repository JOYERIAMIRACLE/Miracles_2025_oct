{
  "kind": "collectionType",
  "collectionName": "tareas",
  "info": {
    "singularName": "tarea",
    "pluralName": "tareas",
    "displayName": "tarea"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "text"
    },
    "ambito": {
      "type": "enumeration",
      "enum": [
        "personal",
        "trabajo"
      ],
      "required": true,
      "default": "personal"
    },
    "estado": {
      "type": "enumeration",
      "enum": [
        "pendiente",
        "en_progreso",
        "completada"
      ],
      "default": "pendiente"
    },
    "prioridad": {
      "type": "enumeration",
      "enum": [
        "baja",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "etiqueta": {
      "type": "string"
    },
    "fechaVencimiento": {
      "type": "date"
    },
    "fechaCompletada": {
      "type": "datetime"
    },
    "notas": {
      "type": "text"
    },
    "proyecto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::proyecto.proyecto",
      "inversedBy": "tareas"
    },
    "progreso": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 0
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "ventas",
  "info": {
    "singularName": "venta",
    "pluralName": "ventas",
    "displayName": "venta"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "concepto": {
      "type": "string",
      "required": true
    },
    "monto": {
      "type": "decimal",
      "required": true
    },
    "fecha": {
      "type": "date",
      "required": true
    },
    "metodoPago": {
      "type": "enumeration",
      "enum": ["Efectivo","Transferencia","Tarjeta","Otro"]
    },
    "cuenta": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cuenta.cuenta",
      "inversedBy": "ventaCuenta"
    },
    "centro_venta": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::centro-venta.centro-venta",
      "inversedBy": "ventayCentrodeventas"
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente",
      "inversedBy": "ventas"
    },
    "producto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "cantidad": {
      "type": "integer",
      "default": 1
    },
    "estado": {
      "type": "enumeration",
      "enum": [
        "Cotizado",
        "Pagado",
        "Preparando",
        "Enviado",
        "Entregado",
        "Cancelado"
      ],
      "default": "Cotizado"
    },
    "notas": {
      "type": "string"
    }
  }
}

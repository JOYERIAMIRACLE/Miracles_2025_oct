{
  "kind": "collectionType",
  "collectionName": "gastos",
  "info": {
    "singularName": "gasto",
    "pluralName": "gastos",
    "displayName": "gasto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "concepto": {
      "type": "string",
      "required": true
    },
    "monto": {
      "type": "decimal"
    },
    "fecha": {
      "type": "date",
      "required": true
    },
    "cuenta": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cuenta.cuenta",
      "inversedBy": "gastos"
    },
    "centro_costo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::centro-costo.centro-costo",
      "inversedBy": "gastoycentrodecostos"
    },
    "comprobante": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "notas": {
      "type": "string"
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "MKT - ADQUISICION",
        "MKT - OPERACION",
        "MKT - DIGITAL",
        "MKT - IMPRENTA",
        "MKT - PROMOCIONALES",
        "MKT - PUBLICIDAD",
        "MKT - NUTRIMIENTO",
        "IT - SOPORTE HARDWARE",
        "IT - LICENCIAS",
        "IT - DESARROLLO",
        "SUMINISTRO - COMPRA MERCANCÍA",
        "SUMINISTRO - MATERIA PRIMA",
        "SUMINISTRO - HERRAMIENTAS"
      ]
    },
    "proveedor": {
      "type": "string"
    },
    "factura": {
      "type": "string"
    },
    "ambito": {
      "type": "enumeration",
      "enum": ["trabajo", "empresa"],
      "default": "trabajo"
    }
  }
}
